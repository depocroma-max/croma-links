{
  "name": "croma-links",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.18" },
  "type": "module",
  "description": "Croma Links — páginas de enlaces por sucursal (sitio estático).",
  "scripts": {
    "dev": "npm run build && npm run preview",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build.mjs --demo",
    "preview:demo": "node scripts/build.mjs --demo --serve",
    "preview": "node scripts/serve-dist.mjs",
    "qr": "node scripts/generate-qr.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm run typecheck && npm run build && npm run build:demo && npm run qr && npm test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
